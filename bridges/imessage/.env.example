# Copy to .env (never commit .env). Only the project secret is secret.

# Photon Spectrum Cloud project (Free plan, iMessage cloud). Not secret.
SPECTRUM_PROJECT_ID=48e46ed2-943d-4b9c-ae1c-cb8396a659d6
# From app.photon.codes > your project > Settings. Secret: paste it here only.
SPECTRUM_PROJECT_SECRET=
# The shared iMessage line Photon assigned to this project (for reference;
# testers text the number shown on the Photon dashboard; not kept in the repo)

# Mimi API (the live demo).
MIMI_API_BASE=https://mimi-agent-tobi-omotade-2cd167ac.atlasflow.dev
# Optional. Empty: the bridge opens its own demo session (its own copy of
# Coral Lane, renewed when it expires). Set it to a console's demo session
# token to make the iMessage shops show up in that console.
MIMI_TOKEN=

# Allowlist and shop mapping (see bridge.config.example.json).
BRIDGE_CONFIG=bridge.config.json
BRIDGE_STATE_DIR=state

# Kill switch: BRIDGE_PAUSED=1, or create the pause file (default state/PAUSE).
BRIDGE_PAUSED=0
# BRIDGE_PAUSE_FILE=state/PAUSE

# Logs never include message text unless this is 1.
BRIDGE_LOG_BODIES=0

# Send replies the owner approves later in the console (polls the shop thread).
BRIDGE_POLL_APPROVALS=1
BRIDGE_POLL_SECONDS=10

# Rate limits (Spectrum free plan: 5,000 sends per day, 50 new conversations per line per day).
BRIDGE_PER_SENDER_PER_MINUTE=6
BRIDGE_PER_SENDER_PER_DAY=60
BRIDGE_DAILY_SEND_CAP=4500
BRIDGE_NEW_SENDERS_PER_DAY=45

# Timeouts and tools.
BRIDGE_HTTP_TIMEOUT_SECONDS=30
BRIDGE_TURN_TIMEOUT_SECONDS=120
# FFMPEG_PATH=ffmpeg
